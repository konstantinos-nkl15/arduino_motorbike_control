function [speed, angle, dtime] = dcmotor_test( m, encoder, Vmax,Vset, timer, step)

resetCount(encoder);
speed_1 = Vset/Vmax;
%speed_2 = -Vset/Vmax;
steps = timer / step;
speed = zeros(2 * steps, 1);
angle = zeros(2 * steps, 1);
ts = NaT(2*steps,1);
m.Speed = speed_1;
start(m);
for i = 2 : steps
    pause(step);
    [angle(i), ts(i)] = readCount(encoder);
    angle(i) = angle(i)* (2 * pi) / 48; 
end

stop(m);
%m.Speed = speed_2;
%start(m);

%for i = steps + 1 : 2* steps
%    pause(0.1);
 %   angle(i) = readCount(encoder)* (2 * pi) /48;
%    speed(i) = (angle(i) - angle(i-1)) / 0.1;
%end

%stop(m);
pause(1);
for i = 2 : length(ts)
speed(i) = (angle(i) - angle(i-1)) / seconds(ts(i)-ts(i-1));
dtime = 
end
end